# Copie para .env local. Nunca versione valores reais deste arquivo.
# Copy to a local .env file. Never commit real credentials in this file.

# Servidor
PORT=8765

# Deezer (público, não requer chave)
DEEZER_BASE_URL=https://api.deezer.com

# TheAudioDB (chave pública de teste '123')
AUDIODB_API_KEY=123

# MusicBrainz (não requer chave, mas precisa de User-Agent)
MUSICBRAINZ_USER_AGENT=OpenMusicHub/1.0 (https://github.com/cnrnival/Clone_Spotify)

# Lyrics.ovh (não requer chave)
LYRICS_OVH_BASE_URL=https://api.lyrics.ovh/v1

# LrcLib (não requer chave)
LRCLIB_BASE_URL=https://lrclib.net/api

# Jamendo (REQUER chave própria - cadastre em https://developer.jamendo.com/)
JAMENDO_CLIENT_ID=

# Genius (opcional - requer chave)
GENIUS_ACCESS_TOKEN=

# Musixmatch (opcional - requer chave)
MUSIXMATCH_API_KEY=
