# Copie este arquivo para .env e informe o Client ID público do app de desenvolvedor Spotify.
# Copy this file to .env and add the public Spotify Client ID from your developer app.
# Nunca inclua client secret, token OAuth, chave Deezer RapidAPI ou qualquer segredo em arquivo commitado.
# Never put a Spotify client secret, OAuth token, Deezer RapidAPI key, or other secret here in a committed file.
SPOTIFY_CLIENT_ID=
PORT=8765
